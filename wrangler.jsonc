{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cat-log",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "catlog.party", "custom_domain": true },
    { "pattern": "www.catlog.party", "custom_domain": true }
  ],
  // One Monopawly room per Durable Object (see src/server/monopawly/game-room.ts).
  "durable_objects": {
    "bindings": [{ "name": "GameRoom", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
