{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cat-log",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "catlog.party", "custom_domain": true },
    { "pattern": "www.catlog.party", "custom_domain": true }
  ],
  // One Durable Object class per online game, one room per object (see
  // src/server/multiplayer/room-server.ts). partyserver serves each binding as a
  // party named after it: MonopawlyRoom is /parties/monopawly-room/<code>.
  "durable_objects": {
    "bindings": [{ "name": "MonopawlyRoom", "class_name": "MonopawlyRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "GameRoom", "to": "MonopawlyRoom" }]
    }
  ]
}
