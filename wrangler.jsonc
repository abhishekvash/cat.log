{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cat-log",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  // Branch Previews (`wrangler preview`) start from production's top-level
  // settings; each gets its own Durable Object namespaces, so rooms in a
  // Preview never touch production rooms.
  "previews": {},
  "routes": [
    { "pattern": "catlog.party", "custom_domain": true },
    { "pattern": "www.catlog.party", "custom_domain": true }
  ],
  // One Durable Object class per online game, one room per object (see
  // src/server/multiplayer/room-server.ts). partyserver serves each binding as a
  // party named after it: MeownopolyRoom is /parties/meownopoly-room/<code>.
  "durable_objects": {
    "bindings": [
      { "name": "MeownopolyRoom", "class_name": "MeownopolyRoom" },
      { "name": "MewdoRoom", "class_name": "MewdoRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "GameRoom", "to": "MonopawlyRoom" }]
    },
    {
      "tag": "v3",
      "renamed_classes": [{ "from": "MonopawlyRoom", "to": "MeownopolyRoom" }]
    },
    { "tag": "v4", "new_sqlite_classes": ["MewdoRoom"] }
  ]
}
