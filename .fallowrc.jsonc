{
	"$schema": "https://fallow.tools/schema.json",
	// Generated by `wrangler types`.
	"ignorePatterns": ["worker-configuration.d.ts"],
	// Vendored shadcn components keep their full API.
	"ignoreExports": [{ "file": "src/components/ui/**", "exports": ["*"] }],
	// react-dom renders the app at runtime; @tailwindcss/vite is loaded by vite.config.ts.
	"ignoreDependencies": ["react-dom", "@tailwindcss/vite"],
	// Long, branchy tests read better as one story; don't score them.
	"health": { "ignore": ["**/*.test.ts"] }
}
